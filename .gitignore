# ==============================================================================  
#  wp-malware-care — .gitignore  
#  
#  Merged from the canonical github/gitignore templates (WordPress, Composer,  
#  Python, Node, Sass, Laravel, Symfony, Jekyll, Ansible, Vagrant + the Global/  
#  JetBrains, VSCode, Vim, Emacs, SublimeText, Eclipse, NetBeans, macOS,  
#  Windows, Linux, Backup, Archives, Tags, Dropbox sets) and gitignore.io,  
#  then trimmed of patterns that would hide real WordPress-plugin source.  
#  
#  Deliberately NOT ignored — see notes inline:  
#    bin/  /index.php  /license.txt  *.pot  *.mo  lib/  phpcs.xml  *.svg  
# ==============================================================================  
  
  
# ==============================================================================  
# 1. SECRETS & ENVIRONMENT  
# ==============================================================================  
.env  
.env.*  
.env-*  
!.env.example  
!.env.sample  
!.env.template  
!.env.dist  
!.env.test.example  
.envrc  
.direnv/  
  
# Explicit variants (already covered above; listed so they are greppable)  
.env.local  
.env.backup  
.env.development  
.env.development.local  
.env.staging  
.env.production  
.env.production.local  
.env.test  
.env.test.local  
.env.ai  
.env-ai  
.env-development  
.env-staging  
.env-production  
.env-test  
  
# Keys, certificates, credential stores  
*.pem  
*.key  
*.p12  
*.pfx  
*.jks  
*.keystore  
*.asc  
*.gpg  
*.ppk  
secring.*  
id_rsa  
id_rsa.*  
id_dsa  
id_dsa.*  
id_ecdsa  
id_ecdsa.*  
id_ed25519  
id_ed25519.*  
**/.ssh/id_*  
**/.ssh/*_id_*  
**/.ssh/known_hosts  
.ssh/  
.aws/  
.gnupg/  
secrets.*  
credentials.*  
auth.json  
.netrc  
.npmrc  
.pypirc  
.htpasswd  
.pgpass  
.my.cnf  
service-account*.json  
gcloud-*.json  
storage/*.key  
http-client.private.env.json  
.streamlit/secrets.toml  
  
  
